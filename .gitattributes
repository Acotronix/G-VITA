# Git LFS tracking rules for large binary files
# Requires: git lfs install  (run once per machine)
#
# The YOLO weights file (yolo11m-pose.pt, ~40 MB) is tracked via LFS.
# The Random Forest classifier (yogamat_pose_classifier_rf.pkl, ~4.8 MB)
# is small enough to commit normally and is NOT tracked by LFS.

*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.h5 filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text
